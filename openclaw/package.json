{
  "name": "@tunpilot/openclaw-plugin",
  "version": "0.2.0",
  "description": "TunPilot OpenClaw plugin — Skill bundle for Hysteria2 / Xray proxy node management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "files": ["dist", "openclaw.plugin.json", "skills", "README.md"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun build src/index.ts --outdir dist --target node --watch"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.3-1"
  },
  "keywords": ["openclaw", "proxy", "hysteria2", "xray", "trojan", "tunpilot"],
  "license": "MIT"
}
